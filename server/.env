# Server configuration for external access

# Collector network binding (use 0.0.0.0 to allow external access)
HOST=0.0.0.0
PORT=4100

# Authentication (disabled for development, enable in production)
AUTH_DISABLED=true

# JWT settings (change before production!)
JWT_SECRET=development-secret-change-before-prod-32-characters-here

# CORS - allow your local network
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://192.168.2.*

# Database path
DATABASE_PATH=../data/logger.db

# Logging level
LOG_LEVEL=info

# JWT token settings
JWT_ISSUER=modbus-data-logger
ACCESS_TOKEN_TTL=8h

# Encryption key (required for production)
SETTINGS_ENCRYPTION_KEY=must-be-at-least-32-characters-long-key-for-encryption
NODE_ENV=development
