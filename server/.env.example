NODE_ENV=development
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info
DATABASE_PATH=../data/logger.db
CORS_ORIGIN=http://localhost:3000
# Enable only behind a trusted reverse proxy; direct clients must not reach 4100.
TRUST_PROXY=false
AUTH_DISABLED=false
JWT_SECRET=replace-with-at-least-32-random-characters
SETTINGS_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
APP_VERSION=1.3.0
# Informational first-install activation countdown; it does not disable features.
LICENSE_ACTIVATION_DAYS=30
# Keep this dedicated directory outside any web/public folder.
# SYSTEM_ADMIN_DATA_DIR=../data/system-admin
# Absolute path to a separately installed, restricted update helper.
# SYSTEM_UPDATE_HELPER=/usr/local/sbin/modbus-logger-update
# Absolute path to a separately installed, restricted OpenVPN helper.
# OPENVPN_HELPER=/usr/local/sbin/modbus-logger-openvpn
JWT_ISSUER=modbus-data-logger
ACCESS_TOKEN_TTL=8h
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-before-production
RETENTION_DAYS=365
POLLING_ENABLED=true
# POSTGRES_URL=postgresql://logger:replace-me@127.0.0.1:5432/modbus_logger
POSTGRES_SSL=false
