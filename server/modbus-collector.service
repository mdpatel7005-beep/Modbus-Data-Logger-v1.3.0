[Unit]
Description=Modbus Data Logger Collector
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Modbus-Data-Logger-v1.3.0
ExecStart=/root/Modbus-Data-Logger-v1.3.0/server/scripts/start-collector.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
