[Unit]
Description=Modbus Data Logger Collector
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Modbus-Data-Logger-v1.3.0
ExecStart=/bin/bash -c "cd /root/Modbus-Data-Logger-v1.3.0 && npm --prefix server run dev:collector"
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
