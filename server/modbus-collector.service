[Unit]
Description=Modbus Data Logger Collector
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Modbus-Data-Logger-v1.3.0
ExecStart=/root/.nvm/versions/node/v22.23.2/bin/npm --prefix server run dev:collector
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
