# Dashboard and Collector Configuration

# Network binding (use 0.0.0.0 to allow external access)
HOST=0.0.0.0
PORT=4100

# CORS - allow your local network
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://192.168.2.*

# Authentication (disabled for development)
AUTH_DISABLED=true

# JWT settings
JWT_SECRET=your-32-char-secret-key-here-change-me-in-production

# Database path
DATABASE_PATH=../data/logger.db

# Logging
LOG_LEVEL=info

# Dashboard API URL (update this for external access)
NEXT_PUBLIC_LOGGER_API_URL=http://0.0.0.0:4100/api/v1
